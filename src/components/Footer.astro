    <p>© {year} KnoxDevs, Inc. — A 501(c)(3) nonprofit</p>
    <div class="flex items-center gap-6">
      <a href="/about/" class="hover:text-white transition-colors">About</a>
      <a href="/groups/" class="hover:text-white transition-colors">Groups</a>
      <a href="/resources/" class="hover:text-white transition-colors">Resources</a>
      <a href="https://github.com/knoxdevs/knoxdevs.github.io" class="hover:text-white transition-colors" target="_blank" rel="noopener noreferrer">GitHub</a>
    </div>
  </div>
