---
interface Link {
  href: string;
  label: string;
  icon: string; // inline SVG path data
  title: string;
}

interface Props {
  name: string;
  description: string;
  image?: string | null;
  imageDir?: string; // e.g. 'groups', 'conferences'
  links?: Link[];
  meta?: string | null; // optional small label below name (e.g. location)
  round?: boolean; // true = round avatar (organizers), false = square logo (groups)
}

const { name, description, image, imageDir = '', links = [], meta, round = false } = Astro.props;

const imgSrc = image && imageDir ? `/images/${imageDir}/${image}` : null;
const truncated = description.length > 200 ? description.slice(0, 200).trimEnd() + '…' : description;
---

<article class="bg-white border border-slate-200 rounded-xl p-5 flex flex-col gap-4 shadow-sm hover:shadow-md transition-shadow">
  <div class="flex items-start gap-4">
    {imgSrc ? (
      <img
        src={imgSrc}
        alt={name}
        class={`w-14 h-14 object-contain flex-shrink-0 ${round ? 'rounded-full object-cover' : 'rounded-lg'}`}
        loading="lazy"
        onerror="this.style.display='none'"
      />
    ) : (
      <div class={`w-14 h-14 flex-shrink-0 bg-brand-light flex items-center justify-center ${round ? 'rounded-full' : 'rounded-lg'}`}>
        <span class="text-brand font-bold text-lg">{name.charAt(0)}</span>
      </div>
    )}
    <div class="min-w-0">
      <h3 class="font-semibold text-slate-900 leading-tight">{name}</h3>
      {meta && <p class="text-xs text-slate-500 mt-0.5">{meta}</p>}
    </div>
  </div>

  <p class="text-sm text-slate-600 leading-relaxed flex-1">{truncated}</p>

  {links.length > 0 && (
    <div class="flex flex-wrap gap-2 pt-1 border-t border-slate-100">
      {links.map(({ href, label, title }) => (
        <a
          href={href}
          target="_blank"
          rel="noopener noreferrer"
          title={title}
          class="text-xs text-slate-500 hover:text-brand transition-colors underline underline-offset-2"
        >
          {label}
        </a>
      ))}
    </div>
  )}
</article>
